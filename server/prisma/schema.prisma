// Modèle de données du budget familial.
// Convention : tous les montants sont des entiers en CENTIMES ;
// la conversion en euros se fait à la frontière de l'API.
//
// Cloisonnement : un compte = un foyer. Toutes les tables métier portent un
// foyerId ; Versement est le seul à en être dépourvu, il est atteint via son
// Projet dont l'appartenance au foyer est vérifiée à chaque accès.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Repartition {
  prorata
  moitie
}

enum TypeTransaction {
  revenu
  depense
}

enum TypeJeton {
  validation
  reinitialisation
}

// Rythme d'une ligne récurrente. Le montant est celui de l'échéance, porté par
// le mois où elle tombe : une assurance annuelle de 240 € pèse 240 € en mars,
// pas 20 € tous les mois. C'est ce que « reste à vivre » veut dire.
enum Periodicite {
  mensuel
  trimestriel
  semestriel
  annuel
}

// Le propriétaire peut inviter, retirer quelqu'un et supprimer le foyer ;
// un membre se sert du budget. Un foyer garde toujours au moins un propriétaire.
enum RoleFoyer {
  proprietaire
  membre
}

// Les réglages d'un foyer, et la racine de son cloisonnement.
model Foyer {
  id           Int           @id @default(autoincrement())
  repartition  Repartition   @default(prorata)
  utilisateurs Utilisateur[]
  invitations  Invitation[]
  membres      Membre[]
  transactions Transaction[]
  credits      Credit[]
  projets      Projet[]
  placements   Placement[]
  budgets      Budget[]

  // Identifiants GoCardless du foyer, saisis par son propriétaire. Facultatifs :
  // sans eux, ce sont ceux de l'installation qui servent, s'il y en a.
  // L'identifiant n'est pas un secret à lui seul ; la clé, si. Elle est chiffrée
  // avec CLE_CHIFFREMENT, qui ne vit pas en base : une copie de celle-ci ne
  // suffit donc pas à la relire.
  goCardlessSecretId         String?
  goCardlessSecretKeyChiffre String?

  // Application Enable Banking du foyer, l'autre prestataire possible — un
  // foyer n'en a qu'un à la fois. L'identifiant d'application est public ; la
  // clé privée (PEM) qui signe les requêtes est chiffrée, comme ci-dessus.
  enableBankingAppId            String?
  enableBankingClePriveeChiffre String?
}

// Un compte appartient à un foyer, et un foyer peut en réunir plusieurs :
// l'application est bâtie autour de deux revenus, les deux personnes doivent
// pouvoir s'y connecter. L'email est stocké normalisé en minuscules.
model Utilisateur {
  id             String    @id @default(cuid())
  email          String    @unique
  motDePasseHash String
  // Null tant que l'adresse n'a pas été confirmée : la connexion est refusée.
  emailValideLe  DateTime?
  foyer          Foyer     @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId        Int
  role           RoleFoyer @default(proprietaire)
  creeLe         DateTime  @default(now())
  jetons         Jeton[]
  sessions       Session[]
  // Le membre du budget que ce compte incarne, s'il y en a un : un membre peut
  // rester une personne sans identifiants, un enfant par exemple.
  membre         Membre?

  // ─── Agrégation bancaire (GoCardless), facultative ───────────────────────
  // Portée par le compte et non par le foyer : chacun relie SA banque, et le
  // consentement donné à la banque est personnel.
  //
  // Aucun secret ici : ces identifiants ne donnent accès à rien sans les clés
  // du serveur. Aucune opération bancaire non plus — seuls les totaux
  // de la dernière synchronisation sont gardés, pour ne pas réinterroger la
  // banque à chaque affichage (GoCardless plafonne les appels par jour).
  agregationActive        Boolean   @default(false)
  // Demande de consentement en cours ou aboutie.
  goCardlessRequisitionId String?
  // Compte bancaire relié ; null tant que le consentement n'a pas abouti.
  goCardlessAccountId     String?
  // Les mêmes repères quand le foyer passe par Enable Banking. `Etat` est la
  // valeur aléatoire d'une demande en cours : le retour de la banque doit la
  // présenter, ce qui prouve qu'il répond bien à la demande de CE compte.
  enableBankingEtat       String?
  enableBankingSessionId  String?
  enableBankingAccountId  String?
  // Synthèse de la dernière synchronisation, en JSON (montants en centimes).
  // Du texte plutôt qu'une colonne Json : un null y reste un null ordinaire, ce
  // que la restauration d'une sauvegarde rejoue sans cas particulier.
  agregationSynthese      String?
  agregationSynchroLe     DateTime?

  @@index([foyerId])
}

// Jetons à usage unique envoyés par email (validation d'adresse, réinitialisation).
// Seule l'empreinte est stockée : une fuite de la base ne donne aucun lien valide.
model Jeton {
  id            String      @id @default(cuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  type          TypeJeton
  jetonHache    String      @unique
  expireLe      DateTime
  utiliseLe     DateTime?
  creeLe        DateTime    @default(now())

  @@index([utilisateurId])
}

// Sessions en base plutôt que JWT : révocables (déconnexion, changement de mot de passe).
model Session {
  id               String      @id @default(cuid())
  utilisateur      Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId    String
  jetonHache       String      @unique
  expireLe         DateTime
  creeLe           DateTime    @default(now())
  // De quoi reconnaître ses propres appareils dans la liste des sessions.
  // Volontairement pas d'adresse IP : elle n'aide personne à s'y retrouver, et
  // ce serait une donnée personnelle de plus à conserver et à justifier.
  appareil         String?
  derniereActivite DateTime    @default(now())

  @@index([utilisateurId])
}

// Invitation à rejoindre un foyer.
//
// Table séparée des jetons ordinaires : ceux-ci visent un utilisateur existant,
// alors qu'une invitation vise une adresse qui n'a peut-être pas encore de
// compte. Comme pour eux, seule l'empreinte du lien est conservée.
model Invitation {
  id         String    @id @default(cuid())
  foyer      Foyer     @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId    Int
  email      String
  role       RoleFoyer @default(membre)
  // Le membre du budget que la personne incarnera, si on le désigne d'avance.
  membre     Membre?   @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId   String?
  jetonHache String    @unique
  expireLe   DateTime
  utiliseLe  DateTime?
  creeLe     DateTime  @default(now())

  @@index([foyerId])
}

model Membre {
  id                  String               @id @default(cuid())
  nom                 String
  revenuMensuel       Int // centimes
  foyer               Foyer                @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId             Int
  transactions        Transaction[]
  versements          Versement[]
  invitations         Invitation[]
  // Le compte qui incarne ce membre, s'il en a un. Supprimer le compte ne
  // supprime pas le membre : ses transactions et son revenu restent au budget.
  utilisateur         Utilisateur?         @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  utilisateurId       String?              @unique
  creeLe              DateTime             @default(now())
  modifieLe           DateTime             @updatedAt
  mouvementPlacements MouvementPlacement[]
  credits             Credit[]
  placements          Placement[]

  @@index([foyerId])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TypeTransaction
  libelle     String
  montant     Int // centimes
  categorie   String
  recurrent   Boolean         @default(false)
  mois        String? // YYYY-MM, null si récurrente
  // Rythme et période de validité d'une ligne récurrente.
  //
  // Sans début ni fin, une récurrente valait pour l'éternité dans les deux sens :
  // résilier un abonnement l'effaçait aussi des mois passés, et changer son prix
  // réécrivait l'histoire. Le début sert aussi d'ancrage aux rythmes non
  // mensuels — un trimestriel commencé en février tombe en février, mai, août.
  periodicite Periodicite     @default(mensuel)
  debut       String? // YYYY-MM ; null = depuis toujours
  fin         String? // YYYY-MM inclus ; null = sans terme
  // Date réelle de l'opération, pour les lignes ponctuelles. Le mois reste : il
  // sert au filtrage et n'a pas à disparaître. Une ligne récurrente n'a pas de
  // date — elle revient tous les mois, elle n'arrive pas un jour précis.
  date        DateTime?
  creeLe      DateTime        @default(now())
  modifieLe   DateTime        @updatedAt
  date      DateTime?
  // Lignes venues d'un relevé bancaire importé. La clé est l'empreinte de
  // l'opération (date, montant, libellé, rang) : réimporter le même relevé, ou
  // un relevé qui le chevauche, ne crée pas de doublon. Le lot réunit les
  // lignes d'un même import, pour pouvoir l'annuler d'un geste.
  importCle String?
  importLot String?
  creeLe    DateTime        @default(now())
  modifieLe DateTime        @updatedAt
  // null = charge (ou revenu) du foyer ; sinon ligne personnelle d'un membre.
  membre      Membre?         @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId    String?
  foyer       Foyer           @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId     Int

  // L'unicité est portée par la base : deux imports simultanés du même relevé
  // ne peuvent pas se doubler. Les lignes saisies à la main n'ont pas de clé,
  // et ne sont donc pas concernées.
  @@unique([foyerId, importCle])
  @@index([foyerId])
}

// Enveloppe mensuelle sur une catégorie de dépenses.
//
// Une seule par catégorie et par foyer : deux budgets concurrents sur « Courses »
// ne voudraient rien dire. Le montant est mensuel, et se compare aux dépenses
// réellement tombées sur le mois — échéances trimestrielles comprises.
model Budget {
  id        String   @id @default(cuid())
  foyer     Foyer    @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId   Int
  categorie String
  montant   Int // centimes
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([foyerId, categorie])
  @@index([foyerId])
}

model Credit {
  id            String   @id @default(cuid())
  libelle       String
  capital       Int // centimes
  taux          Float // taux annuel, en %
  dureeMois     Int
  moisDebut     String // YYYY-MM de la première échéance
  // Assurance emprunteur. Le taux porte soit sur le capital initial (cotisation
  // constante, cas le plus répandu), soit sur le capital restant dû (cotisation
  // décroissante) — d'où la base, sans laquelle le même taux donne des montants
  // du simple au double sur vingt-cinq ans.
  assuranceTaux Float    @default(0) // taux annuel, en %
  assuranceBase String   @default("initial") // "initial" | "restant"
  // À qui appartient l'emprunt : null = le foyer, sinon la personne qui le
  // porte seule. Sa mensualité pèse alors sur elle et non sur la quote-part.
  membre        Membre?  @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId      String?
  foyer         Foyer    @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId       Int
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  @@index([foyerId])
  @@index([membreId])
}

model Projet {
  id               String      @id @default(cuid())
  libelle          String
  objectif         Int // centimes
  echeance         String // YYYY-MM
  versementMensuel Int // centimes
  versements       Versement[]
  foyer            Foyer       @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId          Int
  creeLe           DateTime    @default(now())
  modifieLe        DateTime    @updatedAt

  @@index([foyerId])
}

// Historique des mouvements d'enveloppe : le montant épargné d'un projet
// est la somme de ses versements, jamais un champ figé.
model Versement {
  id       String   @id @default(cuid())
  projet   Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String
  montant  Int // centimes
  date     DateTime @default(now())
  // Qui a mis au pot : null = versement du foyer, sinon le membre concerné.
  membre   Membre?  @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId String?
  creeLe   DateTime @default(now())
}

// Compteurs de la limitation de cadence.
//
// En base plutôt qu'en mémoire : l'API tourne en fonctions sans état, dont les
// instances naissent et meurent en permanence. Un compteur en mémoire repartirait
// de zéro sans cesse et ne freinerait plus rien.
model LimiteCadence {
  cle      String   @id
  compteur Int
  expireLe DateTime

  @@index([expireLe])
}

model Placement {
  id               String               @id @default(cuid())
  libelle          String
  valeur           Int // centimes
  versementMensuel Int // centimes
  rendement        Float // rendement annuel, en %
  // Plafond de versements (livrets réglementés) ; null = pas de plafond.
  plafond          Int? // centimes
  // À qui appartient le support : null = le foyer, sinon la personne seule.
  membre           Membre?              @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId         String?
  mouvements       MouvementPlacement[]
  foyer            Foyer                @relation(fields: [foyerId], references: [id], onDelete: Cascade)
  foyerId          Int
  creeLe           DateTime             @default(now())
  modifieLe        DateTime             @updatedAt

  @@index([foyerId])
  @@index([membreId])
}

// Ce qu'on verse ou retire d'un support, acte par acte. Les intérêts n'y
// figurent pas : ils ne sont l'acte de personne, et se lisent dans l'écart
// entre la valeur du support et la somme des mouvements.
model MouvementPlacement {
  id          String    @id @default(cuid())
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  placementId String
  type        String // "versement" | "retrait"
  montant     Int // centimes, toujours positif : le type porte le sens
  // Ce que valait le support juste après. Impossible à recalculer plus tard :
  // la valeur bouge aussi sans mouvement, quand la banque verse ses intérêts.
  valeurApres Int // centimes
  // Qui a versé : null = mouvement du foyer, sinon le membre concerné.
  membre      Membre?   @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId    String?
  date        DateTime  @default(now())
  creeLe      DateTime  @default(now())

  @@index([placementId])
}
