# Copier ce fichier en `.env` (à la racine du repo) — le garder en place, il sert
# de référence des variables attendues.

# URL de la base Postgres. Sur Neon, elle se trouve dans le tableau de bord ;
# garder `sslmode=require`.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.region.aws.neon.tech/budget?sslmode=require"

# Port de l'API Express (le front Vite proxie /api vers ce port) et port du
# client Vite. S'ils sont déjà utilisés, `npm run dev` prend automatiquement le
# port libre suivant et prévient au démarrage.
PORT=3011
PORT_CLIENT=5173

# En "production", le cookie de session passe en Secure : il n'est alors envoyé
# qu'en HTTPS. À laisser sur "development" tant qu'on travaille en local.
NODE_ENV=development

# ─── Emails ────────────────────────────────────────────────────────────────
# Faut-il confirmer son adresse avant de se servir de son compte ?
# Vide ou 0 : non — l'inscription ouvre la session immédiatement. C'est le
# réglage tant qu'aucun service d'envoi n'est branché, sinon le lien de
# confirmation n'arriverait nulle part et l'inscription serait sans issue.
# 1 : oui — email de confirmation, et connexion refusée tant qu'elle n'a pas eu
# lieu. Tout le circuit est en place, seul ce réglage l'active.
CONFIRMATION_EMAIL_REQUISE=0

# Sans RESEND_API_KEY, les emails ne partent pas : leur contenu et leur lien de
# validation s'affichent dans le journal du serveur. C'est suffisant pour
# développer et essayer tout le parcours d'inscription en local.
# Clé à créer sur https://resend.com (offre gratuite : 100 emails par jour).
RESEND_API_KEY=

# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, laisser l'adresse
# de test ci-dessous : elle fonctionne, mais n'écrit qu'au propriétaire du compte.
EMAIL_EXPEDITEUR="Budget du foyer <onboarding@resend.dev>"

# Adresse publique de l'application : c'est sur elle que sont construits les
# liens envoyés par email. Laissée vide en local, elle suit le port réellement
# utilisé par le client ; sur un déploiement, l'adresse de celui-ci prend le
# relais. À renseigner dès qu'un domaine définitif existe.
APP_URL=

# ─── Déploiement ───────────────────────────────────────────────────────────
# PORT et PORT_CLIENT ne servent qu'au lanceur de développement : ne pas les
# définir sur l'hébergeur. NODE_ENV y vaut « production », ce qui fait passer le
# cookie de session en Secure.
