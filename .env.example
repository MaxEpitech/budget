# Copier ce fichier en `.env` (à la racine du repo) — le garder en place, il sert
# de référence des variables attendues.

# URL de la base Postgres. Sur Neon, elle se trouve dans le tableau de bord ;
# garder `sslmode=require`.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.region.aws.neon.tech/budget?sslmode=require"

# Port de l'API Express (le front Vite proxie /api vers ce port).
PORT=3001

# En "production", le cookie de session passe en Secure : il n'est alors envoyé
# qu'en HTTPS. À laisser sur "development" tant qu'on travaille en local.
NODE_ENV=development

# ─── Emails ────────────────────────────────────────────────────────────────
# Sans RESEND_API_KEY, les emails ne partent pas : leur contenu et leur lien de
# validation s'affichent dans le journal du serveur. C'est suffisant pour
# développer et essayer tout le parcours d'inscription en local.
# Clé à créer sur https://resend.com (offre gratuite : 100 emails par jour).
RESEND_API_KEY=

# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, laisser l'adresse
# de test ci-dessous : elle fonctionne, mais n'écrit qu'au propriétaire du compte.
EMAIL_EXPEDITEUR="Budget du foyer <onboarding@resend.dev>"

# Adresse publique de l'application : c'est sur elle que sont construits les
# liens envoyés par email.
APP_URL=http://localhost:5173
