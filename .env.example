# Copier ce fichier en `.env` (à la racine du repo) — le garder en place, il sert
# de référence des variables attendues.

# URL de la base Postgres. Sur Neon, elle se trouve dans le tableau de bord ;
# garder `sslmode=require`.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.region.aws.neon.tech/budget?sslmode=require"

# Port de l'API Express (le front Vite proxie /api vers ce port).
PORT=3001

# En "production", le cookie de session passe en Secure : il n'est alors envoyé
# qu'en HTTPS. À laisser sur "development" tant qu'on travaille en local.
NODE_ENV=development
