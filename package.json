{
  "name": "budget-foyer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace client",
    "vercel-build": "prisma migrate deploy && npm run build --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "test": "npm test --workspace server",
    "sauvegarder": "npm run sauvegarder --workspace server",
    "rattacher": "npm run rattacher --workspace server --",
    "restaurer": "npm run restaurer --workspace server --",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "node server/prisma/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
